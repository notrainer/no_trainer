{
  "compilerOptions": {
    "lib": ["DOM", "ES2022"],
    "outDir": "./dist",
    "sourceMap": true,
    "declaration": true,
    "target": "es2016",
    "module": "ES2022",
    "allowJs": true,
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["assets/**/*.ts"]
}
